# Ambiente SmartCity Pulse
NODE_ENV=development
ENVIRONMENT=dev

# Postgres (RDS Transacional)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartcity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartcity?schema=public

# AWS / LocalStack Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# Nomes dos Recursos AWS
KINESIS_STREAM_NAME=smartcity-telemetria
DYNAMODB_TELEMETRIA_TABLE=telemetria
DYNAMODB_ESTADO_SENSOR_TABLE=estado_sensor
DYNAMODB_IDEMPOTENCIA_TABLE=idempotencia

SQS_ALERTAS_QUEUE_URL=http://localhost:4566/000000000000/smartcity-alertas-queue
SQS_ALERTAS_DLQ_URL=http://localhost:4566/000000000000/smartcity-alertas-dlq
SQS_OCORRENCIAS_QUEUE_URL=http://localhost:4566/000000000000/smartcity-ocorrencias-imagem-queue

SNS_ALERTAS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:smartcity-alertas-topic

S3_BUCKET_TELEMETRIA_RAW=smartcity-telemetria-raw
S3_BUCKET_IMAGENS=smartcity-ocorrencias-imagens
S3_BUCKET_RELATORIOS=smartcity-relatorios

